#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <700>;       // 300
    delay-ms = <16>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    HRMR: HRMR {
        compatible = "zmk,behavior-hold-tap";
        label = "HRMR";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <280>;
        quick-tap-ms = <175>;
        flavor = "balanced";
        hold-trigger-key-positions = <0 1 2 3 4 5 13 14 15 16 17 18 26 27 28 29 30 31 39 40 41 42 43 44 53 54 56 57 52 19 58 6 45 32 63 62 61 60 59>;
        hold-trigger-on-release;
        require-prior-idle-ms = <150>;
    };

    HRML: HRML {
        compatible = "zmk,behavior-hold-tap";
        label = "HRML";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <280>;
        quick-tap-ms = <175>;
        flavor = "balanced";
        hold-trigger-on-release;
        require-prior-idle-ms = <150>;
        hold-trigger-key-positions = <6 7 8 9 10 11 12 19 20 21 22 23 24 25 32 33 34 35 36 37 38 45 46 47 48 49 50 51 52 57 58 59 60 61 62 63 56 54 53 55>;
    };

    HRMLmouse: HRMLmouse {
        compatible = "zmk,behavior-hold-tap";
        label = "HRMLMOUSE";
        bindings = <&kp>, <&mkp>;

        #binding-cells = <2>;
        tapping-term-ms = <280>;
        quick-tap-ms = <175>;
        flavor = "balanced";
        hold-trigger-key-positions = <53 54 55 56 57 52 19 58 6 45 32 63 62 61 60 59 7 8 9 10 11 12 20 21 22 23 24 25 33 34 35 36 37 38 46 47 48 49 50 51>;
        hold-trigger-on-release;
        require-prior-idle-ms = <150>;
    };

    LayTog: LayTog {
        compatible = "zmk,behavior-hold-tap";
        label = "LAYTOG";
        bindings = <&tog>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <280>;
        quick-tap-ms = <175>;
        flavor = "balanced";
        hold-trigger-on-release;
        require-prior-idle-ms = <150>;
    };

    LayTogTap: LayTogTap {
        compatible = "zmk,behavior-hold-tap";
        label = "LAYTOGTAP";
        bindings = <&kp>, <&tog>;

        #binding-cells = <2>;
        tapping-term-ms = <280>;
        quick-tap-ms = <175>;
        flavor = "balanced";
        hold-trigger-on-release;
        require-prior-idle-ms = <150>;
    };

    behaviors {
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };

        togaming {
            bindings = <&to 4>;
            key-positions = <53 56>;
            layers = <0>;
            require-prior-idle-ms = <100>;
        };

        todefault {
            bindings = <&to 0>;
            key-positions = <53 55>;
            layers = <1 3 2 4 5 6 7>;
            require-prior-idle-ms = <100>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <17 16>;
            require-prior-idle-ms = <100>;
            layers = <0 2 1 3>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <21 22>;
            require-prior-idle-ms = <100>;
            layers = <0 1 2 3>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <22 23>;
            require-prior-idle-ms = <100>;
            layers = <0 1 2 3>;
        };

        layer1 {
            bindings = <&lt 2 ENTER>;
            key-positions = <55 56>;
            layers = <0 1 2 3>;
            require-prior-idle-ms = <100>;
        };

        layer6gaming2 {
            bindings = <&lt 6 ENTER>;
            key-positions = <55 56>;
            require-prior-idle-ms = <100>;
            layers = <4 5 6>;
        };

        l3anddelete {
            bindings = <&lt 3 DEL>;
            key-positions = <60 61>;
            layers = <0 2 1 3>;
            require-prior-idle-ms = <100>;
        };

        btn {
            bindings = <&bt BT_NXT>;
            key-positions = <29 17>;
            require-prior-idle-ms = <100>;
            layers = <0 2 1 3>;
        };

        btp {
            bindings = <&bt BT_PRV>;
            key-positions = <29 43>;
            require-prior-idle-ms = <100>;
            layers = <0 2 1 3>;
        };

        BtCLR {
            bindings = <&bt BT_CLR>;
            key-positions = <14 24>;
            require-prior-idle-ms = <100>;
            layers = <3>;
        };

        layer7anddelete {
            bindings = <&lt 7 DEL>;
            key-positions = <60 61>;
            require-prior-idle-ms = <100>;
            layers = <4 5 6 7>;
        };

        middleclick {
            bindings = <&mkp MCLK>;
            key-positions = <18 31>;
            layers = <3 7>;
            require-prior-idle-ms = <100>;
        };

        Tab {
            bindings = <&kp TAB>;
            key-positions = <30 31>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        VolUp {
            bindings = <&kp C_VOLUME_UP>;
            key-positions = <43 42>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        VolDwn {
            bindings = <&kp C_VOLUME_DOWN>;
            key-positions = <42 41>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        layer8settings {
            bindings = <&tog 8>;
            key-positions = <50 49>;
            require-prior-idle-ms = <200>;
            layers = <0 4 8 9>;
            timeout-ms = <300>;
        };
    };

    macros {
        SHIFT_MCLK: SHIFT_MCLK {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_SHIFT &mkp MB3>;

            label = "SHIFT_MCLK";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&kp ESC       &kp N1        &kp N2        &kp N3              &kp N4         &kp N5                      &kp UP_ARROW     &kp N6                         &kp N7          &kp N8           &kp N9        &kp N0           &kp BACKSPACE
&kp TAB       &kp Q         &kp W         &lt 2 E             &kp R          &HRML LA(LS(LCTRL)) T       &kp DOWN_ARROW   &HRMR RA(RS(RCTRL)) Y          &kp U           &lt 2 I          &kp O         &kp P            &kp BSLH
&kp CAPSLOCK  &HRML LGUI A  &HRML LALT S  &HRML LCTRL D       &HRML LSHFT F  &HRML LC(LA(LS(LGUI))) G    &kp LEFT_ARROW   &HRMR RC(RA(RS(RIGHT_GUI))) H  &HRMR RSHIFT J  &HRMR RCTRL K    &HRMR RALT L  &HRMR RGUI SEMI  &kp APOS
&kp LSHIFT    &kp Z         &kp X         &kp C               &LayTog 3 V    &HRML CAPSLOCK B            &kp RIGHT_ARROW  &HRMR CAPSLOCK N               &kp M           &kp COMMA        &kp DOT       &LayTog 4 FSLH   &kp ENTER
&kp C_MUTE    &kp LCTRL     &kp LEFT_ALT  &mt LEFT_SHIFT TAB  &lt 1 SPACE    &none                       &none            &none                          &lt 1 SPACE     &lt 2 BACKSPACE  &kp RGUI      &key_repeat
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
            display-name = "LAYER0";
        };

        layer1 {
            bindings = <
&trans  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp LC(UP_ARROW)  &trans               &kp C_VOICE_COMMAND                 &trans  &trans                             &trans                   &trans                &trans                  &kp PRINTSCREEN  &trans
&trans  &kp GRAVE             &kp N7                &kp N8            &kp N9               &HRML LA(LS(LCTRL)) C_PP            &trans  &HRMR RA(RS(RCTRL)) PAGE_UP        &kp BACKSPACE            &kp ENTER             &kp ESCAPE              &kp DEL          &trans
&trans  &HRML LGUI DOT        &HRML LEFT_ALT N4     &HRML LCTRL N5    &HRML LEFT_SHIFT N6  &HRML LC(LA(LS(LEFT_GUI))) MINUS    &trans  &HRMR RC(RA(RS(RGUI))) LEFT_ARROW  &HRMR RSHIFT DOWN_ARROW  &HRMR RCTRL UP_ARROW  &HRMR RALT RIGHT_ARROW  &HRMR RGUI APOS  &trans
&trans  &kp N0                &kp N1                &kp N2            &kp N3               &HRML CAPSLOCK EQUAL                &trans  &HRMR CAPSLOCK PG_DN               &kp C_PREV               &kp C_VOLUME_DOWN     &kp C_VOLUME_UP         &kp C_NEXT       &trans
&trans  &trans                &trans                &trans            &trans               &trans                              &trans  &trans                             &trans                   &trans                &trans                  &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
            display-name = "LAYER1";
        };

        layer2 {
            bindings = <
&trans  &trans          &trans         &trans          &trans           &trans                                     &trans  &trans                     &trans             &trans             &trans            &trans            &trans
&trans  &kp F12         &kp F7         &kp F8          &kp F9           &HRML LA(LS(LCTRL)) BACKSLASH              &trans  &HRMR RA(RS(RCTRL)) TILDE  &kp AMPS           &kp STAR           &kp LPAR          &kp COLON         &trans
&trans  &HRML LGUI F11  &HRML LALT F4  &HRML LCTRL F5  &HRML LSHIFT F6  &HRML LC(LA(LS(LEFT_GUI))) LEFT_BRACKET    &trans  &HRMR RC(RA(RS(RGUI))) GT  &HRMR RSHIFT DLLR  &HRMR RCTRL PRCNT  &HRMR RALT CARET  &HRMR RGUI UNDER  &trans
&trans  &kp F10         &kp F1         &kp F2          &kp F3           &HRML CAPSLOCK RIGHT_BRACKET               &trans  &HRMR CAPSLOCK RPAR        &kp EXCL           &kp AT             &kp HASH          &kp PLUS          &trans
&trans  &trans          &trans         &trans          &trans           &trans                                     &trans  &trans                     &trans             &trans             &trans            &trans
            >;

            display-name = "LAYER2";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer3 {
            bindings = <
&soft_off     &ext_power EP_TOG      &rgb_ug RGB_TOG      &rgb_ug RGB_EFF        &rgb_ug RGB_HUI            &rgb_ug RGB_HUD                     &trans  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &rgb_ug RGB_SAI  &rgb_ug RGB_SAD  &rgb_ug RGB_SPI  &rgb_ug RGB_SPD
&out OUT_TOG  &mmv MOVE_LEFT         &mmv MOVE_DOWN       &mmv MOVE_UP           &mmv MOVE_RIGHT            &mkp LCLK                           &trans  &kp KP_DIVIDE    &kp KP_N7        &kp KP_N8        &kp KP_N9        &kp KP_MULTIPLY  &key_repeat
&sys_reset    &HRML LEFT_GUI KP_NUM  &HRML LALT KP_EQUAL  &HRML LCTRL KP_DIVIDE  &HRML LEFT_SHIFT KP_ENTER  &HRMLmouse LC(LA(LS(LGUI))) RCLK    &trans  &kp KP_DOT       &kp KP_NUMBER_4  &kp KP_N5        &kp KP_N6        &kp KP_MINUS     &sys_reset
&bootloader   &kp C_AC_UNDO          &msc SCRL_DOWN       &msc SCRL_UP           &LayTogTap C_AC_REDO 3     &key_repeat                         &trans  &kp KP_N0        &kp KP_N1        &kp KP_N2        &kp KP_N3        &kp KP_PLUS      &bootloader
&trans        &trans                 &trans               &trans                 &trans                     &trans                              &trans  &trans           &trans           &trans           &trans           &trans
            >;

            display-name = "LAYER3";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer4Gaming0 {
            bindings = <
&kp ESC     &kp N1     &kp N2        &kp N3              &kp N4       &kp N5    &kp UP_ARROW     &kp N6  &kp N7       &kp N8           &kp N9         &kp N0          &kp BACKSPACE
&kp TAB     &kp Q      &kp W         &kp E               &kp R        &kp T     &kp DOWN_ARROW   &kp Y   &kp U        &kp I            &kp O          &kp P           &kp BSLH
&kp CAPS    &kp A      &kp S         &kp D               &kp F        &kp G     &kp LEFT_ARROW   &kp H   &kp J        &kp K            &kp L          &kp SEMI        &kp APOS
&kp LSHFT   &kp Z      &kp X         &kp C               &kp V        &kp B     &kp RIGHT_ARROW  &kp N   &kp M        &kp COMMA        &kp DOT        &LayTog 4 FSLH  &kp ENTER
&kp C_MUTE  &kp LCTRL  &kp LEFT_ALT  &mt LEFT_SHIFT TAB  &lt 5 SPACE  &none     &none            &none   &lt 5 SPACE  &lt 6 BACKSPACE  &kp RIGHT_GUI  &key_repeat
            >;

            display-name = "L4GAME0";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer5Gaming1 {
            bindings = <
&trans  &trans     &trans  &trans  &trans  &trans       &trans  &trans                             &trans                   &trans                &trans            &kp PRINTSCREEN  &trans
&trans  &kp GRAVE  &kp N7  &kp N8  &kp N9  &kp ESC      &trans  &HRMR RA(RS(RCTRL)) PAGE_UP        &kp BACKSPACE            &kp ENTER             &kp ESC           &kp DEL          &trans
&trans  &kp DOT    &kp N4  &kp N5  &kp N6  &kp MINUS    &trans  &HRMR RC(RA(RS(RGUI))) LEFT_ARROW  &HRMR RSHIFT DOWN_ARROW  &HRMR RCTRL UP_ARROW  &HRMR RALT RIGHT  &HRMR RGUI APOS  &trans
&trans  &kp N0     &kp N1  &kp N2  &kp N3  &kp EQUAL    &trans  &HRMR CAPSLOCK PAGE_DOWN           &kp C_PREV               &kp C_VOLUME_DOWN     &kp C_VOLUME_UP   &kp C_NEXT       &trans
&trans  &trans     &trans  &trans  &trans  &trans       &trans  &trans                             &trans                   &trans                &trans            &trans
            >;

            display-name = "L5GAME1";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer6Gaming2 {
            bindings = <
&trans  &trans          &trans         &trans          &trans           &trans                                     &trans  &trans                     &trans             &trans             &trans            &trans            &trans
&trans  &kp F12         &kp F7         &kp F8          &kp F9           &HRML LA(LS(LCTRL)) BACKSLASH              &trans  &HRMR RA(RS(RCTRL)) TILDE  &kp AMPS           &kp STAR           &kp LPAR          &kp COLON         &trans
&trans  &HRML LGUI F11  &HRML LALT F4  &HRML LCTRL F5  &HRML LSHIFT F6  &HRML LC(LA(LS(LEFT_GUI))) LEFT_BRACKET    &trans  &HRMR RC(RA(RS(RGUI))) GT  &HRMR RSHIFT DLLR  &HRMR RCTRL PRCNT  &HRMR RALT CARET  &HRMR RGUI UNDER  &trans
&trans  &kp F10         &kp F1         &kp F2          &kp F3           &HRML CAPSLOCK RIGHT_BRACKET               &trans  &HRMR CAPSLOCK RPAR        &kp EXCL           &kp AT             &kp HASH          &kp PLUS          &trans
&trans  &trans          &trans         &trans          &trans           &trans                                     &trans  &trans                     &trans             &trans             &trans            &trans
            >;

            display-name = "L6GAME2";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer7Gaming3 {
            bindings = <
&soft_off     &ext_power EP_TOG      &rgb_ug RGB_TOG      &rgb_ug RGB_EFF        &rgb_ug RGB_HUI            &rgb_ug RGB_HUD                     &trans  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &rgb_ug RGB_SAI  &rgb_ug RGB_SAD  &rgb_ug RGB_SPI  &rgb_ug RGB_SPD
&out OUT_TOG  &mmv MOVE_LEFT         &mmv MOVE_DOWN       &mmv MOVE_UP           &mmv MOVE_RIGHT            &mkp LCLK                           &trans  &kp KP_DIVIDE    &kp KP_N7        &kp KP_N8        &kp KP_N9        &kp KP_MULTIPLY  &key_repeat
&sys_reset    &HRML LEFT_GUI KP_NUM  &HRML LALT KP_EQUAL  &HRML LCTRL KP_DIVIDE  &HRML LEFT_SHIFT KP_ENTER  &HRMLmouse LC(LA(LS(LGUI))) RCLK    &trans  &kp KP_DOT       &kp KP_NUMBER_4  &kp KP_N5        &kp KP_N6        &kp KP_MINUS     &sys_reset
&bootloader   &kp C_AC_UNDO          &msc SCRL_DOWN       &msc SCRL_UP           &LayTogTap C_AC_REDO 7     &key_repeat                         &trans  &kp KP_N0        &kp KP_N1        &kp KP_N2        &kp KP_N3        &kp KP_PLUS      &bootloader
&trans        &trans                 &trans               &trans                 &trans                     &trans                              &trans  &trans           &trans           &trans           &trans           &trans
            >;

            display-name = "L7GAME3";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer8Settings {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;

            label = "L8SETTINGS";
        };

        layer9 {
            display-name = "LAYER9";
            bindings = <
&soft_off     &ext_power EP_TOG      &rgb_ug RGB_TOG      &rgb_ug RGB_EFF        &rgb_ug RGB_HUI            &rgb_ug RGB_HUD                     &trans  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &rgb_ug RGB_SAI  &rgb_ug RGB_SAD  &rgb_ug RGB_SPI  &rgb_ug RGB_SPD
&out OUT_TOG  &mmv MOVE_LEFT         &mmv MOVE_DOWN       &mmv MOVE_UP           &mmv MOVE_RIGHT            &mkp LCLK                           &trans  &kp KP_DIVIDE    &kp KP_N7        &kp KP_N8        &kp KP_N9        &kp KP_MULTIPLY  &key_repeat
&sys_reset    &HRML LEFT_GUI KP_NUM  &HRML LALT KP_EQUAL  &HRML LCTRL KP_DIVIDE  &HRML LEFT_SHIFT KP_ENTER  &HRMLmouse LC(LA(LS(LGUI))) RCLK    &trans  &kp KP_DOT       &kp KP_NUMBER_4  &kp KP_N5        &kp KP_N6        &kp KP_MINUS     &sys_reset
&bootloader   &kp C_AC_UNDO          &msc SCRL_DOWN       &msc SCRL_UP           &LayTogTap C_AC_REDO 3     &key_repeat                         &trans  &kp KP_N0        &kp KP_N1        &kp KP_N2        &kp KP_N3        &kp KP_PLUS      &bootloader
&trans        &trans                 &trans               &trans                 &trans                     &trans                              &trans  &trans           &trans           &trans           &trans           &trans
            >;

            sensor-bindings = <&rsr_vol>, <&rsr_trans>;
        };
    };
};
